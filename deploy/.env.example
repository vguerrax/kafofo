# Copy outside the repository. Empty required values deliberately prevent startup.
COMPOSE_PROJECT_NAME=kafofo
SOURCE_COMMIT=
APP_VERSION=
API_IMAGE=
WEB_IMAGE=
DEPLOY_PLATFORM=linux/amd64
AUTH_BASE_URL=
SITE_ADDRESS=
# internal for a local CA; public for ACME with a publicly reachable domain.
TLS_MODE=internal
HTTP_PORT=80
HTTPS_PORT=443
BIND_ADDRESS=0.0.0.0
DB_PASSWORD_FILE=
AUTH_SECRET_FILE=
# Must be an unused /24 on this host, unique per installation and restoration.
PROXY_SUBNET=172.29.16.0/24
PROXY_ADDRESS=172.29.16.2
PROXY_DYNAMIC_RANGE=172.29.16.128/25
