# Copie para apps/api/.env. Não versione o arquivo preenchido.
HOST=127.0.0.1
PORT=4304
LOG_LEVEL=info
# Configure com as credenciais do seu PostgreSQL local.
# DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/kafofo
# Banco separado e descartável, exclusivamente para pnpm test:db.
# TEST_DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/kafofo_test
# Configure os dois para habilitar autenticação; use segredo aleatório de 32+ caracteres.
# AUTH_SECRET=
# AUTH_BASE_URL=http://127.0.0.1:5304
# Por padrão nenhum proxy é confiável. Informe apenas IPs/CIDRs da sua cadeia.
# TRUSTED_PROXIES=127.0.0.1/32
# Banco descartável exclusivo da suíte de autenticação, nunca a base de uso real.
# AUTH_TEST_DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/kafofo_auth_test

# Banco descartável exclusivo da #8 (configurar no ambiente ao executar as suítes).
# CONTEXT_TEST_DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/kafofo_context_test
