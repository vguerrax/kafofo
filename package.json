{
  "name": "kafofo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @kafofo/contracts build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @kafofo/contracts build && pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @kafofo/contracts build && vitest run",
    "test:db": "pnpm --filter @kafofo/api test:db",
    "test:e2e": "pnpm --filter @kafofo/contracts build && playwright test",
    "db:generate": "pnpm --filter @kafofo/api db:generate",
    "db:migrate": "pnpm --filter @kafofo/api db:migrate",
    "openapi:generate": "pnpm --filter @kafofo/contracts build && pnpm --filter @kafofo/api openapi:generate",
    "openapi:check": "pnpm openapi:generate && redocly lint artifacts/openapi.json",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm openapi:check",
    "prepare": "husky",
    "test:auth:e2e": "pnpm --filter @kafofo/contracts build && playwright test --config playwright.auth.config.ts",
    "test:contexts:e2e": "pnpm --filter @kafofo/contracts build && playwright test --config playwright.contexts.config.ts",
    "test:invitations:e2e": "pnpm --filter @kafofo/contracts build && playwright test --config playwright.invitations.config.ts",
    "test:recovery:e2e": "pnpm --filter @kafofo/contracts build && playwright test --config playwright.recovery.config.ts",
    "test:kitanda:e2e": "pnpm --filter @kafofo/contracts build && playwright test --config playwright.kitanda.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@redocly/cli": "2.76.0",
    "@types/node": "^24.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,css,html}": "prettier --write"
  }
}
